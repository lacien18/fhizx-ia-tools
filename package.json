{
  "name": "fhizx-ai-tools-manager",
  "displayName": "Fhizx AI Tools Manager",
  "description": "Gestiona prompts, agents, skills y notas para herramientas de IA",
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Chat",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fhizx-ai-tools-container",
          "title": "FhizxAITools",
          "icon": "assets/logo.png"
        }
      ]
    },
    "views": {
      "fhizx-ai-tools-container": [
        {
          "id": "fhizxAiTools.notes",
          "name": "Notes",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.tokenCounter",
          "name": "Token Counter",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.agents",
          "name": "Agents",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.skills",
          "name": "Skills",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.prompts",
          "name": "Prompts",
          "icon": ""
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "fhizx-ai-tools.participant",
        "name": "fhizx-ai-tools",
        "description": "Ejecuta prompts, agents y skills guardados en tu espacio global."
      }
    ],
    "commands": [
      {
        "command": "fhizxAiTools.copyToClipboard",
        "title": "Copiar en portapapeles",
        "icon": "$(copy)"
      },
      {
        "command": "fhizxAiTools.sendToChat",
        "title": "Enviar al Chat de IA",
        "icon": "$(wand)"
      },
      {
        "command": "fhizxAiTools.refresh",
        "title": "Refrescar",
        "icon": "$(refresh)"
      },
      {
        "command": "fhizxAiTools.setGlobalPath",
        "title": "Seleccionar Ruta Global",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fhizxAiTools.createPromptFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createPromptFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createAgentFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createAgentFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createSkillFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createSkillFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createNoteFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createNoteFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createFileContext",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createFolderContext",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.renameItem",
        "title": "Modificar Nombre",
        "icon": "$(edit)"
      },
      {
        "command": "fhizxAiTools.deleteItem",
        "title": "Eliminar",
        "icon": "$(trash)"
      },
      {
        "command": "fhizxAiTools.openFile",
        "title": "Abrir Archivo"
      },
      {
        "command": "fhizxAiTools.checkForUpdates",
        "title": "FhizxAITools: Buscar Actualizaciones"
      },
      {
        "command": "fhizxAiTools.installItem",
        "title": "Instalar",
        "icon": "$(add)"
      },
      {
        "command": "fhizxAiTools.uninstallItem",
        "title": "Desinstalar",
        "icon": "$(remove)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fhizxAiTools.refresh",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.setGlobalPath",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createPromptFile",
          "when": "view == fhizxAiTools.prompts",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createPromptFolder",
          "when": "view == fhizxAiTools.prompts",
          "group": "navigation@3"
        },
        {
          "command": "fhizxAiTools.createAgentFile",
          "when": "view == fhizxAiTools.agents",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.createAgentFolder",
          "when": "view == fhizxAiTools.agents",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createSkillFile",
          "when": "view == fhizxAiTools.skills",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.createSkillFolder",
          "when": "view == fhizxAiTools.skills",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createNoteFile",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@3"
        },
        {
          "command": "fhizxAiTools.createNoteFolder",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "fhizxAiTools.sendToChat",
          "when": "viewItem == file_uninstalled || viewItem == file_installed",
          "group": "inline@1"
        },
        {
          "command": "fhizxAiTools.copyToClipboard",
          "when": "viewItem == file_uninstalled || viewItem == file_installed",
          "group": "inline@2"
        },
        {
          "command": "fhizxAiTools.createFileContext",
          "when": "viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "fhizxAiTools.createFolderContext",
          "when": "viewItem == folder",
          "group": "inline@2"
        },
        {
          "command": "fhizxAiTools.renameItem",
          "when": "viewItem == file_uninstalled || viewItem == file_installed || viewItem == folder",
          "group": "inline@3"
        },
        {
          "command": "fhizxAiTools.deleteItem",
          "when": "viewItem == file_uninstalled || viewItem == file_installed || viewItem == folder",
          "group": "inline@4"
        },
        {
          "command": "fhizxAiTools.installItem",
          "when": "view != fhizxAiTools.notes && view != fhizxAiTools.tokenCounter",
          "group": "inline@5"
        },
        {
          "command": "fhizxAiTools.uninstallItem",
          "when": "view != fhizxAiTools.notes && view != fhizxAiTools.tokenCounter",
          "group": "inline@5"
        }
      ],
      "editor/context": [
        {
          "command": "fhizxAiTools.sendToChat",
          "when": "resourceExtname == .md || resourceExtname == .prompt.md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "",
      "properties": {
        "fhizxAiTools.globalPath": {
          "type": "string",
          "default": "",
          "description": "Ruta global donde se almacenarán los prompts, agents, skills y notas."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.12"
  }
}
