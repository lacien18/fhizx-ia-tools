{
  "name": "fhizx-ai-tools-manager",
  "displayName": "Fhizx AI Tools Manager",
  "description": "Gestiona prompts, agents, skills, context y notas para herramientas de IA",
  "version": "1.5.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Chat",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fhizx-ai-tools-container",
          "title": "FhizxAITools",
          "icon": "assets/logo.png"
        }
      ]
    },
    "views": {
      "fhizx-ai-tools-container": [
        {
          "id": "fhizxAiTools.configurations",
          "name": "⚙️ Configurations",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.notes",
          "name": "📓 Notes",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.tokenCounter",
          "name": "🔢 Token Counter",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.agents",
          "name": "🤖 Agents",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.skills",
          "name": "🚀 Skills",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.context",
          "name": "🧠 Context",
          "icon": ""
        },
        {
          "id": "fhizxAiTools.prompts",
          "name": "📝 Prompts",
          "icon": ""
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "fhizx-ai-tools.participant",
        "name": "fhizx-ai-tools",
        "description": "Ejecuta prompts, agents y skills guardados en tu espacio global."
      }
    ],
    "commands": [
      {
        "command": "fhizxAiTools.copyToClipboard",
        "title": "Copiar en portapapeles",
        "icon": "$(copy)"
      },
      {
        "command": "fhizxAiTools.sendToChat",
        "title": "Enviar al Chat de IA",
        "icon": "$(wand)"
      },
      {
        "command": "fhizxAiTools.refresh",
        "title": "Refrescar",
        "icon": "$(refresh)"
      },
      {
        "command": "fhizxAiTools.setGlobalPath",
        "title": "Seleccionar Ruta Global",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fhizxAiTools.createPromptFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createPromptFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createAgentFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createAgentFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createSkillFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createSkillFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createContextFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createContextFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createNoteFile",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createNoteFolder",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.createFileContext",
        "title": "Crear Archivo",
        "icon": "$(file-add)"
      },
      {
        "command": "fhizxAiTools.createFolderContext",
        "title": "Crear Carpeta",
        "icon": "$(new-folder)"
      },
      {
        "command": "fhizxAiTools.renameItem",
        "title": "Modificar Nombre",
        "icon": "$(edit)"
      },
      {
        "command": "fhizxAiTools.deleteItem",
        "title": "Eliminar",
        "icon": "$(trash)"
      },
      {
        "command": "fhizxAiTools.openFile",
        "title": "Abrir Archivo"
      },
      {
        "command": "fhizxAiTools.checkForUpdates",
        "title": "FhizxAITools: Buscar Actualizaciones"
      },
      {
        "command": "fhizxAiTools.list",
        "title": "FhizxAITools: Listar Recursos",
        "icon": "$(list-flat)"
      },
      {
        "command": "fhizxAiTools.installItem",
        "title": "Instalar",
        "icon": "$(add)"
      },
      {
        "command": "fhizxAiTools.uninstallItem",
        "title": "Desinstalar",
        "icon": "$(remove)"
      },
      {
        "command": "fhizxAiTools.toggleInstall",
        "title": "Instalar / Desinstalar en Copilot",
        "icon": "$(find-selection)"
      },
      {
        "command": "fhizxAiTools.openGlobalPath",
        "title": "Abrir Ruta Global",
        "icon": "$(folder-opened)"
      },
      {
        "command": "fhizxAiTools.cloudConnect",
        "title": "Conectar a Nube (GitHub)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fhizxAiTools.cloudPush",
        "title": "Subir a la Nube",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "fhizxAiTools.cloudPull",
        "title": "Bajar desde la Nube",
        "icon": "$(cloud-download)"
      },
      {
        "command": "fhizxAiTools.cloudDisconnect",
        "title": "Desconectar Nube",
        "icon": "$(cloud-upload)"
      }
    ],
    "submenus": [
      {
        "id": "fhizxAiTools.itemMenu",
        "label": "Opciones",
        "icon": "$(kebab-vertical)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fhizxAiTools.refresh",
          "when": "view == fhizxAiTools.configurations",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.setGlobalPath",
          "when": "view == fhizxAiTools.configurations",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.cloudConnect",
          "when": "view == fhizxAiTools.configurations",
          "group": "navigation@3"
        },
        {
          "command": "fhizxAiTools.createPromptFile",
          "when": "view == fhizxAiTools.prompts",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createPromptFolder",
          "when": "view == fhizxAiTools.prompts",
          "group": "navigation@3"
        },
        {
          "command": "fhizxAiTools.createAgentFile",
          "when": "view == fhizxAiTools.agents",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.createAgentFolder",
          "when": "view == fhizxAiTools.agents",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createContextFile",
          "when": "view == fhizxAiTools.context",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.createContextFolder",
          "when": "view == fhizxAiTools.context",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createSkillFile",
          "when": "view == fhizxAiTools.skills",
          "group": "navigation@1"
        },
        {
          "command": "fhizxAiTools.createSkillFolder",
          "when": "view == fhizxAiTools.skills",
          "group": "navigation@2"
        },
        {
          "command": "fhizxAiTools.createNoteFile",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@3"
        },
        {
          "command": "fhizxAiTools.createNoteFolder",
          "when": "view == fhizxAiTools.notes",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "fhizxAiTools.openGlobalPath",
          "when": "viewItem == config_status && view == fhizxAiTools.configurations",
          "group": "inline"
        },
        {
          "command": "fhizxAiTools.toggleInstall",
          "when": "viewItem == config_action && view == fhizxAiTools.configurations",
          "group": "inline"
        },
        {
          "submenu": "fhizxAiTools.itemMenu",
          "when": "viewItem == file_uninstalled || viewItem == file_installed || viewItem == folder",
          "group": "inline"
        }
      ],
      "fhizxAiTools.itemMenu": [
        {
          "command": "fhizxAiTools.sendToChat",
          "when": "viewItem == file_uninstalled || viewItem == file_installed",
          "group": "1_actions@1"
        },
        {
          "command": "fhizxAiTools.copyToClipboard",
          "when": "viewItem == file_uninstalled || viewItem == file_installed",
          "group": "1_actions@2"
        },
        {
          "command": "fhizxAiTools.installItem",
          "when": "viewItem == file_uninstalled && view != fhizxAiTools.notes && view != fhizxAiTools.tokenCounter",
          "group": "2_installation@1"
        },
        {
          "command": "fhizxAiTools.uninstallItem",
          "when": "viewItem == file_installed && view != fhizxAiTools.notes && view != fhizxAiTools.tokenCounter",
          "group": "2_installation@2"
        },
        {
          "command": "fhizxAiTools.createFileContext",
          "when": "viewItem == folder",
          "group": "1_actions@1"
        },
        {
          "command": "fhizxAiTools.createFolderContext",
          "when": "viewItem == folder",
          "group": "1_actions@2"
        },
        {
          "command": "fhizxAiTools.renameItem",
          "group": "3_management@1"
        },
        {
          "command": "fhizxAiTools.deleteItem",
          "group": "3_management@2"
        }
      ],
      "editor/context": [
        {
          "command": "fhizxAiTools.sendToChat",
          "when": "resourceExtname == .md || resourceExtname == .prompt.md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "",
      "properties": {
        "fhizxAiTools.globalPath": {
          "type": "string",
          "default": "",
          "description": "Ruta global donde se almacenarán los prompts, agents, skills, context y notas."
        },
        "fhizxAiTools.cloud.owner": {
          "type": "string",
          "default": "",
          "description": "Usuario u organización de GitHub donde se guardan tus recursos en la nube."
        },
        "fhizxAiTools.cloud.repo": {
          "type": "string",
          "default": "",
          "description": "Repositorio privado de GitHub (se crea automáticamente si no existe)."
        },
        "fhizxAiTools.cloud.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Sube automáticamente los cambios a la nube al crear, modificar o eliminar archivos."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.x",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.12"
  }
}
